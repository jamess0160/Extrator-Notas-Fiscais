# Endpoint publico de consulta de NFC-e do SEFAZ-RS.
# A CLI usa este mesmo valor como default quando a variavel nao esta definida.
SEFAZ_URL=https://www.sefaz.rs.gov.br/ASP/AAE_ROOT/NFE/SAT-WEB-NFE-NFC_2.asp

# Opcionais
# SEFAZ_TIMEOUT_MS=15000
# CLI_CONCURRENCY=3

# Consulta de cadastro por CNPJ (nome fantasia e CNAE). Vale para os dois comandos.
# CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1/
# CNPJ_LOOKUP=off

# Cache em disco das consultas de CNPJ. Sem ele, "scan" e "full" consultam o mesmo
# CNPJ duas vezes, porque sao processos separados.
# CNPJ_CACHE=off
# CNPJ_CACHE_PATH=~/.extrator-nfe/cnpj.json
# CNPJ_CACHE_TTL_DAYS=30
